<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net40;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- .NET 8.0 specific settings -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- .NET 4.0 specific settings -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net40'">
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Folder structure for Visual Studio -->
  <ItemGroup>
    <Folder Include="Config\" />
    <Folder Include="Core\" />
    <Folder Include="Core\Enums\" />
    <Folder Include="Core\Interfaces\" />
    <Folder Include="Infrastructure\" />
    <Folder Include="Infrastructure\Renderers\" />
    <Folder Include="Infrastructure\Utils\" />
  </ItemGroup>

  <!-- Exclude console app source and documentation files from compilation -->
  <ItemGroup>
    <Compile Remove="ZplRenderer.Console\**" />
    <Compile Remove="EXAMPLES.cs" />
    <Compile Remove="SAMPLE.zpl" />
    <EmbeddedResource Remove="ZplRenderer.Console\**" Condition="'$(TargetFramework)' != 'net40'" />
    <None Remove="ZplRenderer.Console\**" />
    <None Include="README.md" />
    <None Include="SAMPLE.zpl" />
  </ItemGroup>

  <!-- System.Drawing.Common for net40 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- System.Drawing.Common for net8.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- .NET 8.0 dependencies -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="BinaryKits.Zpl.Viewer" Version="1.3.0" />
    <!-- Costura.Fody temporarily disabled due to file lock issues -->
    <!--<PackageReference Include="Costura.Fody" Version="5.8.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>-->
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.0.0" />
    <PackageReference Include="itext7" Version="9.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.2" />
  </ItemGroup>

  <!-- .NET 4.0 dependencies -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.Bcl.Async" Version="1.0.168" />
  </ItemGroup>

  <!-- Embed console app for .NET 4.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <EmbeddedResource Include="ZplRenderer.Console\bin\Release\net8.0\win-x64\publish\ZplRenderer.Console.exe">
      <Link>ZplRenderer.Console.exe</Link>
      <LogicalName>ZplRenderer.Console.exe</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Ensure native dependencies are available for .NET 8.0 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Auto-publish Console app before building .NET 4.0 target -->
  <Target Name="PublishConsoleApp" BeforeTargets="BeforeBuild" Condition="'$(TargetFramework)' == 'net40' AND !Exists('ZplRenderer.Console\bin\Release\net8.0\win-x64\publish\ZplRenderer.Console.exe')">
    <Message Text="Publishing ZplRenderer.Console for embedding..." Importance="high" />
    <Exec Command="dotnet publish $(MSBuildProjectDirectory)\ZplRenderer.Console\ZplRenderer.Console.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=true -p:TrimMode=partial" />
  </Target>

  <!-- Verify embedded console app exists -->
  <Target Name="VerifyEmbeddedConsoleApp" BeforeTargets="BeforeBuild" Condition="'$(TargetFramework)' == 'net40'">
    <Error Condition="!Exists('ZplRenderer.Console\bin\Release\net8.0\win-x64\publish\ZplRenderer.Console.exe')"
           Text="Console app not found. Please run: dotnet publish ZplRenderer.Console\ZplRenderer.Console.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=true -p:TrimMode=partial" />
  </Target>

  <!-- Manually copy Windows native assets for .NET 8.0 only -->
  <Target Name="CopyWindowsNativeAssets" AfterTargets="AfterBuild" Condition="'$(TargetFramework)' == 'net8.0'">
    <ItemGroup>
      <SkiaSharpWinX64 Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.1\runtimes\win-x64\native\*.dll" />
      <SkiaSharpWinX86 Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.1\runtimes\win-x86\native\*.dll" />
      <SkiaSharpWinArm64 Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32\3.119.1\runtimes\win-arm64\native\*.dll" />
      <HarfBuzzWinX64 Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\8.3.1.2\runtimes\win-x64\native\*.dll" />
      <HarfBuzzWinX86 Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\8.3.1.2\runtimes\win-x86\native\*.dll" />
      <HarfBuzzWinArm64 Include="$(NuGetPackageRoot)harfbuzzsharp.nativeassets.win32\8.3.1.2\runtimes\win-arm64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SkiaSharpWinX64)" DestinationFolder="$(OutDir)runtimes\win-x64\native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SkiaSharpWinX86)" DestinationFolder="$(OutDir)runtimes\win-x86\native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SkiaSharpWinArm64)" DestinationFolder="$(OutDir)runtimes\win-arm64\native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HarfBuzzWinX64)" DestinationFolder="$(OutDir)runtimes\win-x64\native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HarfBuzzWinX86)" DestinationFolder="$(OutDir)runtimes\win-x86\native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HarfBuzzWinArm64)" DestinationFolder="$(OutDir)runtimes\win-arm64\native" SkipUnchangedFiles="true" />
  </Target>

</Project>
