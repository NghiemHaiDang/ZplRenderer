{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Framework Launch",
            "type": "clr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/ZplRendererTest/bin/Debug/net40/ZplRendererTest.exe",
            "args": [],
            "cwd": "${workspaceFolder}/ZplRendererTest/bin/Debug/net40",
            "stopAtEntry": false,
            "console": "externalTerminal"
        },
        {
            "name": ".NET Framework Attach",
            "type": "clr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}
